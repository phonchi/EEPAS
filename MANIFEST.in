# MANIFEST.in - Include additional files in distribution

# Documentation
include README.md
include USAGE.md
include LICENSE

# Configuration
include requirements.txt
include config*.json

# Data files (for reference, actual data may be too large)
graft data
prune data/*.mat

# Documentation
graft docs
prune docs/*.pyc

# Analysis tools
graft analysis
graft utils

# Exclude development files
global-exclude __pycache__
global-exclude *.py[co]
global-exclude *.log
global-exclude .gitignore
global-exclude .DS_Store

# Exclude results
prune results
prune results_*
prune .archive
