#!/usr/bin/env python3
"""
EEPAS模型參數三階段優化 - EEPAS第三階段核心優化模組

== 地震學背景 ==
EEPAS模型有8個參數需要估計：
  - 震級分布：am, bm, Sm（前震震級與主震震級的關係）
  - 時間分布：at, bt, St（前震時間與主震時間的關係）
  - 空間分布：ba, Sa（前震空間與主震空間的關係）
  - 混合參數：u（failure-to-predict rate，無前震信號的地震比例）

== 三階段優化策略 ==
為避免參數空間過大導致優化困難，採用分階段優化：

第一階段：固定斜率參數(bm=1, bt=0.3, ba=0.3)，優化 am, at, Sa, u
  - 目的：確定截距和空間尺度的初步值

第二階段：固定第一階段結果，優化 Sm, bt, St, ba, u
  - 目的：確定變異數和斜率的精細值

第三階段：聯合優化所有8個參數
  - 目的：獲得全局最優解

本模組使用Numba JIT並行化計算（對應MATLAB的parfor）
"""

import numpy as np
import sys
import os
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from eepas_likelihood import eepas_likelihood
from utils.data_loader import DataLoader
from utils.fminsearchcon import fminsearchcon
from scipy.optimize import basinhopping, minimize, differential_evolution


def optimize_eepas_parameters(mi, xi, ti, yi, xj, yj, mj, tj,
                              me, xe, te, ye, W, EW, B, T1, T2, m0,
                              CELLE, params, config_file='config.json',
                              multi_start=False, n_starts=3, single_stage=False,
                              use_basinhopping=False, basinhopping_niter=20, optimizer='fminsearchcon',
                              region_manager=None, use_fast_mode=False, magnitude_samples=20):
    """
    EEPAS模型參數優化主函數

    地震學意義：
        估計8個EEPAS參數，使模型最好地擬合地震目錄中的前震-主震關係

    參數：
        mi, xi, ti, yi: 目標地震（M≥mT）的震級、位置、時間
        xj, yj, mj, tj: PPE背景計算用的歷史地震（M≥mT）
        me, xe, te, ye: EEPAS前震（M≥m₀）
        W: 餘震去權重數組（wᵢ，降低餘震的前震地位）
        EW: 權重平均值（E[W]）
        B: Gutenberg-Richter b值
        T1, T2: 學習時間窗口
        m0: 完整度震級
        CELLE: 空間網格定義
        params: 其他模型參數（PPE參數、delay等）
        config_file: 配置文件路徑
        multi_start: 是否使用多起始點搜索（預設False，增強穩健性但較慢）
        n_starts: 多起始點數量（預設3）
        single_stage: 是否使用單階段全參數優化（預設False，使用三階段）
        use_fast_mode: 是否使用快速模式（預設False）
            - True: 使用 Numba JIT 加速的中點矩形法（快速）
            - False: 使用精確的 quad_vec 積分（慢但精確）
        magnitude_samples: 快速模式的採樣點數（預設 20，增加可提高精度）

    返回：
        result: 字典，包含最優EEPAS參數和負對數似然值
            {'am', 'bm', 'Sm', 'at', 'bt', 'St', 'ba', 'Sa', 'u', 'ln_likelihood'}
    """

    # 載入配置
    cfg = DataLoader.load_config(config_file)

    # ===== 輸出優化任務信息 =====
    if single_stage:
        print('\n╔══════════════════════════════════════════════════════════╗')
        print('║      EEPAS 單階段全參數優化開始                          ║')
        print('╠══════════════════════════════════════════════════════════╣')
        print(f'║ 目標地震數量: {len(mi):<42d} ║')
        print(f'║ EEPAS地震數量（M≥m₀）: {len(me):<32d} ║')
        print(f'║ PPE地震數量（M≥mT）: {len(mj):<34d} ║')
        print('║                                                          ║')
        print('║ 🚀 單階段：聯合優化所有8個參數                          ║')
        print('║    優化參數：am, Sm, at, bt, St, ba, Sa, u             ║')
        print('║    固定參數：bm = 0.86                                  ║')
        print('╚══════════════════════════════════════════════════════════╝\n')
    else:
        print('\n╔══════════════════════════════════════════════════════════╗')
        print('║      EEPAS 三階段參數優化開始                            ║')
        print('╠══════════════════════════════════════════════════════════╣')
        print(f'║ 目標地震數量: {len(mi):<42d} ║')
        print(f'║ EEPAS地震數量（M≥m₀）: {len(me):<32d} ║')
        print(f'║ PPE地震數量（M≥mT）: {len(mj):<34d} ║')
        print('║                                                          ║')
        print('║ 📈 第一階段：優化 am, at, Sa, u                         ║')
        print('║    固定 bm=1, bt=0.3, Sm=0.2, St=0.15, ba=0.3           ║')
        print('║ 📈 第二階段：優化 Sm, bt, St, ba, u                     ║')
        print('║    固定第一階段的 am, at, bm, Sa                        ║')
        print('║ 📈 第三階段：聯合優化所有8個參數                        ║')
        print('╚══════════════════════════════════════════════════════════╝\n')

    # ===== 預先計算並緩存 PPE 正規化積分 =====
    # 地震學意義：PPE背景積分在優化過程中不變，預計算可節省大量時間
    # 對於8參數優化（可能評估數百次目標函數），緩存可節省數小時計算時間
    print('⚡ 預先計算 PPE 正規化積分並緩存...')
    if '_ppe_integral_cached' not in params:
        a = params['a']
        d = params['d']
        s = params['s']
        delay = params['delay']
        m0 = params['m0']
        mT = params['mT']
        mu = params.get('mu', 7.5)

        from ppe_optimization import calculate_ppe_normalization
        Xpol = np.column_stack([CELLE[:, 0], CELLE[:, 0], CELLE[:, 1], CELLE[:, 1]])
        Ypol = np.column_stack([CELLE[:, 2], CELLE[:, 3], CELLE[:, 3], CELLE[:, 2]])
        profile_opts = {'mu': mu, 'kernelMagFilter': 'mT', 'integralLower': 'mT'}

        integral_PPE, _, _, _ = calculate_ppe_normalization(
            a, d, s, B, xj, yj, mj, tj, Xpol, Ypol, CELLE, delay, m0, mT,
            profile_opts, ti, T1, T2, spatial_samples=40
        )

        params['_ppe_integral_cached'] = integral_PPE
        print(f'   ✓ PPE 積分已緩存: {integral_PPE:.6f}')
    else:
        print(f'   ✓ 使用已緩存的 PPE 積分: {params["_ppe_integral_cached"]:.6f}')
    print()

    # ===== 單階段全參數優化 =====
    if single_stage:
        print('🚀 單階段優化：聯合優化所有8個參數')

        # 從配置文件讀取 bm（固定值）
        bm = cfg['optimization']['stage3']['fixedValues']['bm']
        print(f'   固定參數：bm = {bm:.2f}')

        # 初始值：結合 stage1 和 stage2 的初始值
        # stage1: [am, at, Sa, u]
        # stage2: [Sm, bt, St, ba, u]
        # stage3 順序: [am, Sm, at, bt, St, ba, Sa, u]
        stage1_init = cfg['optimization']['stage1']['initialValues']  # [am, at, Sa, u]
        stage2_init = cfg['optimization']['stage2']['initialValues']  # [Sm, bt, St, ba, u]

        x0_single = np.array([
            stage1_init[0],  # am
            stage2_init[0],  # Sm
            stage1_init[1],  # at
            stage2_init[1],  # bt
            stage2_init[2],  # St
            stage2_init[3],  # ba
            stage1_init[2],  # Sa
            stage1_init[3]   # u
        ])

        # 邊界設定：使用 stage3 的邊界
        lb_single = np.array(cfg['optimization']['stage3']['lowerBounds'])
        ub_single = np.array(cfg['optimization']['stage3']['upperBounds'])

        print(f'   初始值：')
        print(f'     am={x0_single[0]:.2f}, Sm={x0_single[1]:.2f}, at={x0_single[2]:.2f}, bt={x0_single[3]:.2f}')
        print(f'     St={x0_single[4]:.2f}, ba={x0_single[5]:.2f}, Sa={x0_single[6]:.2f}, u={x0_single[7]:.2f}')

        iteration_count = [0]
        def objective_single(P):
            """
            單階段目標函數
            P = [am, Sm, at, bt, St, ba, Sa, u]
            """
            fd, _, _, _ = eepas_likelihood(
                P[0], bm, P[1], P[2], P[3], P[4], P[5], P[6], P[7],
                mi, xi, ti, yi, xj, yj, mj, tj, me, xe, te, ye,
                W, EW, B, T1, T2, m0, CELLE, params,
                region_manager=region_manager, use_fast_mode=use_fast_mode, magnitude_samples=magnitude_samples
            )
            iteration_count[0] += 1
            if iteration_count[0] % 10 == 0:
                print(f'   迭代 {iteration_count[0]:4d}: NLL = {fd:.6f}', flush=True)
            return fd

        # === 選擇優化策略 ===
        if use_basinhopping:
            # 選擇局部優化器
            local_optimizer = optimizer if optimizer in ['L-BFGS-B', 'TNC', 'SLSQP'] else 'L-BFGS-B'
            print(f'   🏔️  使用 Basin-Hopping 全局優化 (迭代={basinhopping_niter}, 局部優化器={local_optimizer})...')

            # Basin-hopping 需要邊界約束
            from scipy.optimize import Bounds
            bounds = Bounds(lb_single, ub_single)

            # 靜默版目標函數（basin-hopping會調用很多次）
            def objective_silent(P):
                fd, _, _, _ = eepas_likelihood(
                    P[0], bm, P[1], P[2], P[3], P[4], P[5], P[6], P[7],
                    mi, xi, ti, yi, xj, yj, mj, tj, me, xe, te, ye,
                    W, EW, B, T1, T2, m0, CELLE, params,
                    region_manager=region_manager, use_fast_mode=use_fast_mode, magnitude_samples=magnitude_samples
                )
                return fd

            # Basin-hopping callback顯示進度
            bh_step = [0]
            bh_best = [np.inf]
            def bh_callback(x, f, accept):
                bh_step[0] += 1
                if f < bh_best[0]:
                    bh_best[0] = f
                    print(f'   → 步驟 {bh_step[0]:3d}: NLL={f:.6f} {"✓接受" if accept else ""}', flush=True)
                return False

            result_bh = basinhopping(
                objective_silent,
                x0_single,
                niter=basinhopping_niter,
                minimizer_kwargs={
                    'method': local_optimizer,
                    'bounds': bounds,
                    'options': {'maxiter': 500, 'ftol': 1e-6}
                },
                callback=bh_callback,
                seed=42
            )

            x_final = result_bh.x
            fval_final = result_bh.fun
            exitflag = 0 if result_bh.lowest_optimization_result.success else 1
            output = {
                'iterations': bh_step[0],
                'funcCount': result_bh.nfev,
                'message': f'Basin-hopping completed with {bh_step[0]} steps'
            }
            print(f'   ✅ Basin-hopping 完成: {bh_step[0]} 步, 最佳 NLL={fval_final:.6f}', flush=True)

        elif multi_start:
            print(f'   🎯 使用多起始點搜索 ({n_starts} 個起始點, 優化器={optimizer})...')

            # 生成多個起始點
            start_points = [x0_single]
            np.random.seed(42)
            for i in range(n_starts - 1):
                # 在初始值附近擾動 (±30%範圍內)
                perturbation = 0.3 * (2 * np.random.rand(len(x0_single)) - 1)
                random_start = x0_single * (1 + perturbation)
                random_start = np.clip(random_start, lb_single, ub_single)
                start_points.append(random_start)

            # 保存所有候選解
            candidates = []

            for i, start_point in enumerate(start_points):
                print(f'\n   起始點 {i+1}/{n_starts}:')
                print(f'     am={start_point[0]:.2f}, Sm={start_point[1]:.2f}, at={start_point[2]:.2f}, bt={start_point[3]:.2f}')
                print(f'     St={start_point[4]:.2f}, ba={start_point[5]:.2f}, Sa={start_point[6]:.2f}, u={start_point[7]:.2f}')

                iteration_count[0] = 0  # 重置計數器

                if optimizer == 'fminsearchcon':
                    x_temp, fval_temp, exitflag_temp, output_temp = fminsearchcon(
                        objective_single, start_point,
                        lb=lb_single, ub=ub_single,
                        options={'maxiter': 10000, 'maxfun': 10000, 'xtol': 1e-8, 'ftol': 1e-6, 'disp': False}
                    )
                elif optimizer in ['L-BFGS-B', 'TNC', 'SLSQP', 'Powell']:
                    if optimizer == 'L-BFGS-B':
                        # L-BFGS-B: 繼續調嚴格（1e-6仍太少→1e-7）
                        result = minimize(
                            objective_single, start_point,
                            method=optimizer,
                            bounds=list(zip(lb_single, ub_single)),
                            options={'maxiter': 10000, 'maxfun': 10000, 'ftol': 1e-9, 'gtol': 1e-7, 'disp': False}
                        )
                    elif optimizer == 'TNC':
                        # TNC: 維持原設定（表現合理）
                        result = minimize(
                            objective_single, start_point,
                            method=optimizer,
                            bounds=list(zip(lb_single, ub_single)),
                            options={'maxiter': 10000, 'maxfun': 10000, 'ftol': 1e-9, 'gtol': 1e-3, 'xtol': 1e-8, 'disp': False}
                        )
                    elif optimizer == 'SLSQP':
                        # SLSQP: 繼續調嚴格（1e-10仍太少→1e-12）
                        result = minimize(
                            objective_single, start_point,
                            method=optimizer,
                            bounds=list(zip(lb_single, ub_single)),
                            options={'maxiter': 10000, 'ftol': 1e-12, 'disp': False}
                        )
                    elif optimizer == 'Powell':
                        # Powell 使用絕對 ftol（與 fmin 相同）
                        result = minimize(
                            objective_single, start_point,
                            method=optimizer,
                            bounds=list(zip(lb_single, ub_single)),
                            options={'maxiter': 10000, 'maxfev': 10000, 'ftol': 1e-6, 'xtol': 1e-8, 'disp': False}
                        )
                    x_temp = result.x
                    fval_temp = result.fun
                    exitflag_temp = 0 if result.success else 1
                    output_temp = {
                        'iterations': result.nit if hasattr(result, 'nit') else 0,
                        'funcCount': result.nfev,
                        'message': result.message
                    }
                else:
                    raise ValueError(f'不支持的優化器: {optimizer}')

                print(f'   → 完成: NLL={fval_temp:.6f}', flush=True)
                candidates.append((x_temp, fval_temp, exitflag_temp, output_temp))

            # 選擇最好的
            best_idx = np.argmin([c[1] for c in candidates])
            x_final, fval_final, exitflag, output = candidates[best_idx]

            print(f'\n   ✅ 最佳起始點: {best_idx+1}/{n_starts}, NLL={fval_final:.6f}', flush=True)

        else:
            print(f'   開始優化（使用 {optimizer}）...')
            # 標準單起始點優化
            if optimizer == 'fminsearchcon':
                x_final, fval_final, exitflag, output = fminsearchcon(
                    objective_single, x0_single,
                    lb=lb_single, ub=ub_single,
                    options={'maxiter': 10000, 'maxfun': 10000, 'xtol': 1e-8, 'ftol': 1e-6, 'disp': False}
                )
            elif optimizer in ['L-BFGS-B', 'TNC', 'SLSQP', 'Powell']:
                if optimizer == 'L-BFGS-B':
                    # L-BFGS-B: 繼續調嚴格（1e-6仍太少→1e-7）
                    result = minimize(
                        objective_single, x0_single,
                        method=optimizer,
                        bounds=list(zip(lb_single, ub_single)),
                        options={'maxiter': 10000, 'maxfun': 10000, 'ftol': 1e-9, 'gtol': 1e-7}
                    )
                elif optimizer == 'TNC':
                    # TNC: 維持原設定（表現合理）
                    result = minimize(
                        objective_single, x0_single,
                        method=optimizer,
                        bounds=list(zip(lb_single, ub_single)),
                        options={'maxiter': 10000, 'maxfun': 10000, 'ftol': 1e-9, 'gtol': 1e-3, 'xtol': 1e-8}
                    )
                elif optimizer == 'SLSQP':
                    # SLSQP: 繼續調嚴格（1e-10仍太少→1e-12）
                    result = minimize(
                        objective_single, x0_single,
                        method=optimizer,
                        bounds=list(zip(lb_single, ub_single)),
                        options={'maxiter': 10000, 'ftol': 1e-12}
                    )
                elif optimizer == 'Powell':
                    # Powell 使用絕對 ftol（與 fmin 相同）
                    result = minimize(
                        objective_single, x0_single,
                        method=optimizer,
                        bounds=list(zip(lb_single, ub_single)),
                        options={'maxiter': 10000, 'maxfev': 10000, 'ftol': 1e-6, 'xtol': 1e-8}
                    )
                x_final = result.x
                fval_final = result.fun
                exitflag = 0 if result.success else 1
                output = {
                    'iterations': result.nit if hasattr(result, 'nit') else 0,
                    'funcCount': result.nfev,
                    'message': result.message
                }
            else:
                raise ValueError(f'不支持的優化器: {optimizer}')

        print(f'\n   ✅ 單階段優化完成', flush=True)
        print(f'   exitflag: {exitflag}', flush=True)
        print(f'   迭代次數: {output.get("iterations", "N/A")}', flush=True)
        print(f'   函數評估次數: {output.get("funcCount", "N/A")}', flush=True)
        print(f'   停止原因: {output.get("message", "N/A")}', flush=True)
        print(f'   最終參數：', flush=True)
        print(f'     am={x_final[0]:.6f}, bm={bm:.6f}, Sm={x_final[1]:.6f}', flush=True)
        print(f'     at={x_final[2]:.6f}, bt={x_final[3]:.6f}, St={x_final[4]:.6f}', flush=True)
        print(f'     ba={x_final[5]:.6f}, Sa={x_final[6]:.6f}, u={x_final[7]:.6f}', flush=True)
        print(f'   最終 NLL: {fval_final:.6f}\n', flush=True)

        # 返回結果
        result = {
            'am': x_final[0],
            'bm': bm,
            'Sm': x_final[1],
            'at': x_final[2],
            'bt': x_final[3],
            'St': x_final[4],
            'ba': x_final[5],
            'Sa': x_final[6],
            'u': x_final[7],
            'ln_likelihood': -fval_final
        }

        return result

    # ===== 第一階段：優化 am, at, Sa, u =====
    # 地震學意義：
    #   - 固定斜率參數（bm, bt, ba），先確定截距和空間尺度
    #   - am: 震級截距（前震震級預測主震震級的基準值）
    #   - at: 時間截距（前震時間預測主震時間的基準值）
    #   - Sa: 空間標準差（前震位置預測主震位置的基準值）
    #   - u: failure-to-predict rate（無前震信號的地震比例）
    print('🔄 第一階段：優化 am, at, Sa, u')

    # 從配置文件讀取固定參數值
    fixedVals = cfg['optimization']['stage1']['fixedValues']
    bm = fixedVals['bm']  # 震級斜率（固定為1，線性關係）
    Sm = fixedVals['Sm']  # 震級標準差（初步假設）
    bt = fixedVals['bt']  # 時間斜率（固定為0.3，典型經驗值）
    St = fixedVals['St']  # 時間標準差（初步假設）
    ba = fixedVals['ba']  # 空間斜率（固定為0.3，震級每增加1，空間範圍擴大2倍）

    print(f'   固定參數：bm={bm:.2f}, Sm={Sm:.2f}, bt={bt:.2f}, St={St:.2f}, ba={ba:.2f}')

    # 讀取優化初始值和邊界
    x0_stage1 = np.array(cfg['optimization']['stage1']['initialValues'])
    lb_stage1 = np.array(cfg['optimization']['stage1']['lowerBounds'])
    ub_stage1 = np.array(cfg['optimization']['stage1']['upperBounds'])

    print(f'   初始值：am={x0_stage1[0]:.2f}, at={x0_stage1[1]:.2f}, Sa={x0_stage1[2]:.2f}, u={x0_stage1[3]:.2f}')
    print('   開始優化...')

    # 定義目標函數（第一階段）
    iteration_count = [0]  # 迭代計數器（使用list以便在nested function中修改）
    def objective_stage1(P):
        """
        第一階段目標函數
        P = [am, at, Sa, u]
        """
        # 調用EEPAS似然函數計算NLL
        fd, _, _, _ = eepas_likelihood(
            P[0], bm, Sm, P[1], bt, St, ba, P[2], P[3],  # 8個參數（4個優化+5個固定）
            mi, xi, ti, yi, xj, yj, mj, tj, me, xe, te, ye,
            W, EW, B, T1, T2, m0, CELLE, params,
            region_manager=region_manager, use_fast_mode=use_fast_mode, magnitude_samples=magnitude_samples
        )
        # 每10次迭代輸出一次進度
        iteration_count[0] += 1
        if iteration_count[0] == 1 or iteration_count[0] % 10 == 0:
            print(f'   迭代 {iteration_count[0]:4d}: NLL = {fd:.6f}, am={P[0]:.4f}, at={P[1]:.4f}, Sa={P[2]:.4f}, u={P[3]:.6f}', flush=True)
        return fd

    # 使用約束優化器（Nelder-Mead with bounds）
    # 容差設定與MATLAB一致：xtol=1e-8, ftol=1e-8
    x_stage1, fval_stage1, exitflag, output = fminsearchcon(
        objective_stage1, x0_stage1,
        lb=lb_stage1, ub=ub_stage1,
        options={'maxiter': 5000, 'xtol': 1e-8, 'ftol': 1e-8, 'disp': False}
    )

    result_stage1 = type('obj', (object,), {'x': x_stage1, 'fun': fval_stage1})()

    x_stage1 = result_stage1.x
    print(f'\n   ✅ 第一階段完成', flush=True)
    print(f'   最佳值：am={x_stage1[0]:.6f}, at={x_stage1[1]:.6f}, Sa={x_stage1[2]:.6f}, u={x_stage1[3]:.6f}', flush=True)
    print(f'   階段NLL: {result_stage1.fun:.6f}\n', flush=True)

    am, at, Sa, u = x_stage1

    # ===== 第二階段：優化 Sm, bt, St, ba, u =====
    # 地震學意義：
    #   - 固定第一階段結果（am, at, bm, Sa），精調變異數和斜率參數
    #   - Sm: 震級標準差（前震震級預測主震震級的散布程度）
    #   - bt: 時間斜率（震級對前兆時間的影響）
    #   - St: 時間標準差（前兆時間的散布程度）
    #   - ba: 空間斜率（震級對前震空間範圍的影響）
    #   - u: 重新優化failure-to-predict rate
    print('🔄 第二階段：優化 Sm, bt, St, ba, u', flush=True)

    # 初始值（u使用第一階段結果）
    init_vals_stage2 = cfg['optimization']['stage2']['initialValues']
    x0_stage2 = []
    for val in init_vals_stage2:
        if isinstance(val, str) and 'u_from_stage1' in val:
            x0_stage2.append(u)
        else:
            x0_stage2.append(float(val))
    x0_stage2 = np.array(x0_stage2)

    lb_stage2 = np.array(cfg['optimization']['stage2']['lowerBounds'])
    ub_stage2 = np.array(cfg['optimization']['stage2']['upperBounds'])

    def objective_stage2(P):
        fd, _, _, _ = eepas_likelihood(
            am, bm, P[0], at, P[1], P[2], P[3], Sa, P[4],
            mi, xi, ti, yi, xj, yj, mj, tj, me, xe, te, ye,
            W, EW, B, T1, T2, m0, CELLE, params,
            region_manager=region_manager, use_fast_mode=use_fast_mode, magnitude_samples=magnitude_samples
        )
        return fd

    # 使用Differential Evolution全局優化（對初始值不敏感且快速）
    use_differential_evolution = False

    if use_differential_evolution:
        print(f'   🧬 使用 Differential Evolution 全局優化', flush=True)

        # 邊界約束 (轉換為(min, max)元組列表)
        bounds_list = list(zip(lb_stage2, ub_stage2))

        # Callback顯示進度
        de_iter = [0]
        de_best = [np.inf]
        def de_callback(xk, convergence):
            de_iter[0] += 1
            fval = objective_stage2(xk)
            if fval < de_best[0]:
                de_best[0] = fval
                print(f'   → 迭代 {de_iter[0]}: NLL={fval:.6f}, Sm={xk[0]:.3f}', flush=True)
            return False

        result_de = differential_evolution(
            objective_stage2,
            bounds_list,
            strategy='best1bin',
            maxiter=30,   # 減少迭代次數加快速度
            popsize=10,   # 減小種群大小
            tol=1e-6,     # 放寬容差
            seed=42,
            disp=False,
            workers=1,
            callback=de_callback
        )

        x_stage2 = result_de.x
        fval_stage2 = result_de.fun
        print(f'   ✅ Differential Evolution 完成: {de_iter[0]} 代, 最佳NLL={fval_stage2:.6f}', flush=True)
        result_stage2 = type('obj', (object,), {'x': x_stage2, 'fun': fval_stage2})()

    elif multi_start:
        print(f'   🎯 使用多起始點搜索 ({n_starts} 個起始點) + Stage3快速評估', flush=True)

        # 提前準備Stage3的邊界
        lb_stage3 = np.array(cfg['optimization']['stage3']['lowerBounds'])
        ub_stage3 = np.array(cfg['optimization']['stage3']['upperBounds'])

        # 生成多個起始點 - 在初始值附近擾動而不是完全隨機
        start_points = [x0_stage2]
        np.random.seed(42)  # 固定隨機種子確保可重現
        for i in range(n_starts - 1):
            # 在初始值附近擾動 (±50%範圍內)
            perturbation = 0.5 * (2 * np.random.rand(len(x0_stage2)) - 1)  # [-0.5, 0.5]
            random_start = x0_stage2 * (1 + perturbation)
            random_start[4] = u + np.random.randn() * 0.05  # u在stage1結果附近擾動
            random_start = np.clip(random_start, lb_stage2, ub_stage2)
            start_points.append(random_start)

        # 保存所有候選解
        candidates = []

        for i, start_point in enumerate(start_points):
            print(f'   起始點 {i+1}/{n_starts}: Sm={start_point[0]:.2f}, bt={start_point[1]:.2f}, St={start_point[2]:.2f}, ba={start_point[3]:.2f}, u={start_point[4]:.2f}', flush=True)

            x_temp, fval_temp, _, _ = fminsearchcon(
                objective_stage2, start_point,
                lb=lb_stage2, ub=ub_stage2,
                options={'maxiter': 5000, 'xtol': 1e-8, 'ftol': 1e-8, 'disp': False}
            )

            print(f'   → Stage2 NLL={fval_temp:.6f}, Sm={x_temp[0]:.3f}', flush=True)

            # 快速評估Stage3最終效果
            x0_stage3_test = np.array([am, x_temp[0], at, x_temp[1], x_temp[2], x_temp[3], Sa, x_temp[4]])

            def objective_stage3_test(P):
                fd, _, _, _ = eepas_likelihood(
                    P[0], bm, P[1], P[2], P[3], P[4], P[5], P[6], P[7],
                    mi, xi, ti, yi, xj, yj, mj, tj, me, xe, te, ye,
                    W, EW, B, T1, T2, m0, CELLE, params,
                    region_manager=region_manager, use_fast_mode=use_fast_mode, magnitude_samples=magnitude_samples
                )
                return fd

            # 快速優化500步評估（需要足夠步數才能看出差異）
            x_test, fval_test, _, _ = fminsearchcon(
                objective_stage3_test, x0_stage3_test,
                lb=lb_stage3, ub=ub_stage3,
                options={'maxiter': 500, 'xtol': 1e-6, 'ftol': 1e-6, 'disp': False}
            )

            print(f'   → Stage3快速評估 NLL={fval_test:.6f}', flush=True)
            candidates.append((x_temp, fval_temp, fval_test))

        # 選擇Stage3評估最好的
        best_idx = np.argmin([c[2] for c in candidates])
        x_stage2 = candidates[best_idx][0]
        fval_stage2 = candidates[best_idx][1]
        print(f'   ✨ 選擇起始點{best_idx+1}: Stage2 NLL={fval_stage2:.6f}, Stage3評估 NLL={candidates[best_idx][2]:.6f}', flush=True)

        result_stage2 = type('obj', (object,), {'x': x_stage2, 'fun': fval_stage2})()
    else:
        print(f'   初始值：Sm={x0_stage2[0]:.2f}, bt={x0_stage2[1]:.2f}, St={x0_stage2[2]:.2f}, ba={x0_stage2[3]:.2f}, u={x0_stage2[4]:.2f}', flush=True)
        print('   開始優化...', flush=True)

        iteration_count[0] = 0
        def objective_stage2_verbose(P):
            fd = objective_stage2(P)
            iteration_count[0] += 1
            if iteration_count[0] % 10 == 0:
                print(f'   迭代 {iteration_count[0]:4d}: NLL = {fd:.6f}', flush=True)
            return fd

        x_stage2, fval_stage2, exitflag, output = fminsearchcon(
            objective_stage2_verbose, x0_stage2,
            lb=lb_stage2, ub=ub_stage2,
            options={'maxiter': 5000, 'xtol': 1e-8, 'ftol': 1e-8, 'disp': False}
        )
        result_stage2 = type('obj', (object,), {'x': x_stage2, 'fun': fval_stage2})()

    x_stage2 = result_stage2.x
    print(f'   ✅ 第二階段完成', flush=True)
    print(f'   最佳值：Sm={x_stage2[0]:.6f}, bt={x_stage2[1]:.6f}, St={x_stage2[2]:.6f}, ba={x_stage2[3]:.6f}, u={x_stage2[4]:.6f}', flush=True)
    print(f'   階段目標值: {result_stage2.fun:.6f}\n', flush=True)

    Sm, bt, St, ba, u = x_stage2

    # ===== 第三階段：聯合優化所有8個參數 =====
    # 地震學意義：
    #   - 基於前兩階段的結果，全局優化所有參數以獲得最佳擬合
    #   - 同時調整所有參數以捕捉參數間的相互作用
    #   - P = [am, Sm, at, bt, St, ba, Sa, u]（bm固定為1）
    print('🔄 第三階段：聯合優化所有參數', flush=True)

    # 使用前兩階段結果作為初始值
    x0_stage3 = np.array([am, Sm, at, bt, St, ba, Sa, u])
    lb_stage3 = np.array(cfg['optimization']['stage3']['lowerBounds'])
    ub_stage3 = np.array(cfg['optimization']['stage3']['upperBounds'])

    print(f'   初始值：[{", ".join([f"{v:.2f}" for v in x0_stage3])}]', flush=True)
    print('   開始優化...', flush=True)

    iteration_count[0] = 0
    def objective_stage3(P):
        """
        第三階段目標函數
        P = [am, Sm, at, bt, St, ba, Sa, u]
        """
        fd, _, _, _ = eepas_likelihood(
            P[0], bm, P[1], P[2], P[3], P[4], P[5], P[6], P[7],  # 8個參數（bm=1固定）
            mi, xi, ti, yi, xj, yj, mj, tj, me, xe, te, ye,
            W, EW, B, T1, T2, m0, CELLE, params,
            region_manager=region_manager, use_fast_mode=use_fast_mode, magnitude_samples=magnitude_samples
        )
        iteration_count[0] += 1
        if iteration_count[0] % 10 == 0:
            print(f'   迭代 {iteration_count[0]:4d}: NLL = {fd:.6f}', flush=True)
        return fd

    # 使用 fminsearchcon
    # 增強收斂: 提高 maxiter 和 maxfun 並降低容差以匹配 MATLAB
    # Bug修復：必須同時設定 maxiter 和 maxfun，否則會被 maxfun 的默認值 (200*n) 限制
    # ftol 設為 1e-6：太小會在局部震盪處提前停止，太大會收斂不足
    # 測試顯示需要 ~3000 次函數評估才能充分收斂
    x_final, fval_final, exitflag, output = fminsearchcon(
        objective_stage3, x0_stage3,
        lb=lb_stage3, ub=ub_stage3,
        options={'maxiter': 10000, 'maxfun': 10000, 'xtol': 1e-8, 'ftol': 1e-6, 'disp': False}
    )

    result_stage3 = type('obj', (object,), {'x': x_final, 'fun': fval_final})()

    x_final = result_stage3.x
    print(f'   ✅ 第三階段完成', flush=True)
    print(f'   exitflag: {exitflag}', flush=True)
    print(f'   迭代次數: {output.get("iterations", "N/A")}', flush=True)
    print(f'   函數評估次數: {output.get("funcCount", "N/A")}', flush=True)
    print(f'   停止原因: {output.get("message", "N/A")}', flush=True)
    print(f'   最終參數：', flush=True)
    print(f'     am={x_final[0]:.6f}, bm={bm:.6f}, Sm={x_final[1]:.6f}', flush=True)
    print(f'     at={x_final[2]:.6f}, bt={x_final[3]:.6f}, St={x_final[4]:.6f}', flush=True)
    print(f'     ba={x_final[5]:.6f}, Sa={x_final[6]:.6f}, u={x_final[7]:.6f}', flush=True)
    print(f'   最終目標值: {result_stage3.fun:.6f}\n', flush=True)

    # 返回結果
    result = {
        'am': x_final[0],
        'bm': bm,
        'Sm': x_final[1],
        'at': x_final[2],
        'bt': x_final[3],
        'St': x_final[4],
        'ba': x_final[5],
        'Sa': x_final[6],
        'u': x_final[7],
        'ln_likelihood': -result_stage3.fun
    }

    return result